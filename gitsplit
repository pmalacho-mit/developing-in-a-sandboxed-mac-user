#!/usr/bin/env bash
#
# gitsplit — helpers for the two-user "dev commits, admin publishes" Git workflow.
#
#   - The dev user owns and commits in its own clone (no push credentials).
#   - The admin user (you) keeps a separate clone with the real push creds,
#     pulls the dev user's commits across locally (the hardened fetch path),
#     and pushes to the remote. The admin never runs git *inside* the dev repo
#     and never uses `sudo git`, so nothing gets ownership-poisoned and no
#     dev-controlled hook/config ever executes as admin.
#
# Configure via env vars (or edit the defaults below):
#   GITSPLIT_DEV_USER, GITSPLIT_ADMIN_USER, GITSPLIT_ADMIN_ROOT,
#   GITSPLIT_DEV_ROOT, GITSPLIT_DEFAULT_BRANCH, GITSPLIT_YES

set -euo pipefail

# ---------------------------- configuration ----------------------------
DEV_USER="${GITSPLIT_DEV_USER:-dev}"                       # less-privileged dev account
ADMIN_USER="${GITSPLIT_ADMIN_USER:-$(id -un)}"             # you (the admin account)
ADMIN_ROOT="${GITSPLIT_ADMIN_ROOT:-$HOME/code}"            # admin-side clones (full push creds)
DEV_ROOT="${GITSPLIT_DEV_ROOT:-/Users/$DEV_USER/code}"     # dev-side working clones
DEFAULT_BRANCH="${GITSPLIT_DEFAULT_BRANCH:-main}"
# -----------------------------------------------------------------------

die()  { printf 'gitsplit: %s\n' "$*" >&2; exit 1; }
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }

require_not_root() {
  [ "$(id -u)" -ne 0 ] || die "run this as your admin user, not under sudo."
}

# Run a command as the dev user with the dev user's HOME (so its own SSH keys
# and git config are used — not yours).
run_as_dev() { sudo -H -u "$DEV_USER" -- "$@"; }

# Give the admin user inherited read + traverse on the dev clone via a macOS
# ACL, without opening the dev user's whole home directory to everyone.
grant_admin_read() {
  local path="$1"
  # traverse-only (no listing) down to the clone; ignore if the ACE already exists
  sudo chmod +a "$ADMIN_USER allow search" "/Users/$DEV_USER" "$DEV_ROOT" 2>/dev/null || true
  # read + inherit on the clone itself, so commits the dev user makes later
  # stay readable to you without re-running anything
  sudo chmod -R +a \
    "$ADMIN_USER allow read,execute,list,search,readattr,readextattr,readsecurity,file_inherit,directory_inherit" \
    "$path"
}

cmd_clone() {
  require_not_root
  local url="${1:-}"; [ -n "$url" ] || die "usage: gitsplit clone <git-url> [name]"
  local name="${2:-$(basename "$url" .git)}"
  local admin_dir="$ADMIN_ROOT/$name"
  local dev_dir="$DEV_ROOT/$name"

  [ -e "$admin_dir" ] && die "$admin_dir already exists"
  [ -e "$dev_dir" ]   && die "$dev_dir already exists"

  info "Cloning admin copy (full push creds) -> $admin_dir"
  mkdir -p "$ADMIN_ROOT"
  git clone "$url" "$admin_dir"

  info "Preparing dev clone directory"
  sudo mkdir -p "$DEV_ROOT"
  sudo chown "$DEV_USER:staff" "$DEV_ROOT"

  info "Cloning dev copy as '$DEV_USER' -> $dev_dir"
  # Requires the dev account to have READ access to the remote (a read-only
  # deploy key, or a public repo). It deliberately holds no push credentials.
  run_as_dev git clone "$url" "$dev_dir"

  info "Granting your admin user read access to the dev clone"
  grant_admin_read "$dev_dir"

  # Allow your upload-pack to read the dev-owned repo during fetch. This only
  # suppresses the ownership refusal for *this* path; the fetch path still
  # ignores any dangerous config/hooks in that repo, so it stays safe.
  git config --global --add safe.directory "$dev_dir"

  info "Wiring 'dev' remote on the admin copy"
  git -C "$admin_dir" remote add dev "$dev_dir"
  git -C "$admin_dir" fetch dev

  info "Done."
  info "Develop in:  $dev_dir   (as '$DEV_USER')"
  info "Publish with: cd $admin_dir && gitsplit publish"
}

cmd_publish() {
  require_not_root
  local branch="${1:-$DEFAULT_BRANCH}"
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "run this inside an admin clone."
  git remote get-url dev >/dev/null 2>&1 || die "no 'dev' remote here — was this set up with 'gitsplit clone'?"

  info "Fetching dev's commits"
  git fetch dev

  git rev-parse --verify --quiet "dev/$branch" >/dev/null || die "dev has no branch '$branch'."

  local range count
  if git rev-parse --verify --quiet "origin/$branch" >/dev/null; then
    range="origin/$branch..dev/$branch"
  else
    range="dev/$branch"   # branch doesn't exist on origin yet
  fi
  count="$(git rev-list --count "$range")"

  if [ "$count" -eq 0 ]; then
    info "Nothing new to publish on '$branch'."
    return 0
  fi

  info "$count commit(s) to publish to origin/$branch:"
  git --no-pager log --oneline "$range"
  echo

  if [ "${GITSPLIT_YES:-0}" != "1" ]; then
    printf 'Push these to origin/%s? [y/N] ' "$branch"
    read -r reply || reply=""
    case "$reply" in
      y|Y|yes|YES) ;;
      *) die "aborted." ;;
    esac
  fi

  info "Pushing dev/$branch -> origin/$branch"
  git push origin "dev/$branch:$branch"
  info "Published."
}

cmd_status() {
  require_not_root
  local branch="${1:-$DEFAULT_BRANCH}"
  git remote get-url dev >/dev/null 2>&1 || die "no 'dev' remote here."
  git fetch dev -q
  git fetch origin -q 2>/dev/null || true
  info "origin/$branch  <->  dev/$branch   (<  only on origin,  >  only on dev)"
  git --no-pager log --oneline --left-right "origin/$branch...dev/$branch" 2>/dev/null \
    || info "branch '$branch' is missing on one side."
}

cmd_help() {
  cat <<'EOF'
gitsplit — two-user "dev commits, admin publishes" Git workflow.

Usage:
  gitsplit clone <git-url> [name]   Set up admin + dev clones, wire the 'dev' remote.
  gitsplit publish [branch]         (run in an admin clone) Fetch dev, review, push.
  gitsplit status  [branch]         Show what dev has that origin doesn't, and vice versa.
  gitsplit help

Config (env vars, defaults in parentheses):
  GITSPLIT_DEV_USER       dev account name (dev)
  GITSPLIT_ADMIN_USER     your account name (current user)
  GITSPLIT_ADMIN_ROOT     admin-side clones ($HOME/code)
  GITSPLIT_DEV_ROOT       dev-side clones (/Users/$GITSPLIT_DEV_USER/code)
  GITSPLIT_DEFAULT_BRANCH default branch (main)
  GITSPLIT_YES=1          skip the publish confirmation prompt
EOF
}

case "${1:-help}" in
  clone)            shift; cmd_clone "$@" ;;
  publish)          shift; cmd_publish "$@" ;;
  status)           shift; cmd_status "$@" ;;
  help|-h|--help)   cmd_help ;;
  *)                die "unknown command '$1' (try: gitsplit help)" ;;
esac
